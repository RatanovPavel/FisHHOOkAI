@echo off
chcp 65001 > nul
echo 🪐 [FishHookAI]: Автономный агент синхронизации запущен!
echo 🔄 Мониторю изменения в папке и отправляю на GitHub...
echo 💡 Чтобы остановить синхронизацию, просто закройте это окно терминала.
echo ---------------------------------------------------------------------

:loop
:: 1. Проверяем, есть ли измененные файлы в папке
git status --porcelain | findstr /R "^" >nul
if %errorlevel% equ 0 (
    echo [ Git ]: Обнаружены изменения в коде! Начинаю авто-отправку...
    
    :: Индексируем все новые и измененные файлы
    git add .
    
    :: Делаем автоматический коммит с текущим временем
    git commit -m "Auto-update: %date% %time%"
    
    :: Отправляем файлы на ваш репозиторий RatanovPavel/FishHookAI
    git push -q origin main
    
    echo ✅ [ Git ]: Код успешно обновлен на GitHub!
    echo ---------------------------------------------------------------------
)

:: 2. Задержка в 15 секунд перед следующей проверкой папки
timeout /t 15 /nobreak > nul
goto loop
